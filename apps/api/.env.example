# ============================================================================
# SCHOOL ERP PLATFORM - API ENVIRONMENT
# Copy to .env and fill real values. NEVER commit .env
# ============================================================================

# --- Application ---
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
APP_NAME="School ERP Platform"
APP_URL=http://localhost:4000
WEB_URL=http://localhost:3000
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
DEFAULT_LOCALE=en

# --- Database ---
DATABASE_URL=postgresql://erp:erp_password@localhost:5432/school_erp?schema=public
DATABASE_POOL_SIZE=10
DATABASE_LOG_QUERIES=false

# --- Redis ---
REDIS_URL=redis://:erp_redis@localhost:6379
REDIS_PREFIX=erp
CACHE_TTL_SECONDS=60

# --- JWT / Auth ---
JWT_SECRET=change-me-super-secret-access-token-key-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-super-secret-refresh-token-key-min-32-chars
JWT_REFRESH_EXPIRES_IN=30d
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
EMAIL_VERIFY_TOKEN_TTL_HOURS=48
OTP_TTL_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
COOKIE_SECRET=change-me-cookie-signing-secret
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# --- Rate limiting ---
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=10

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,capacitor://localhost

# --- File storage: 's3' | 'cloudinary' | 'local' ---
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage/local
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/static
MAX_UPLOAD_SIZE_MB=15
SIGNED_URL_TTL_SECONDS=900

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=school-erp
S3_ACCESS_KEY=erpminio
S3_SECRET_KEY=erpminio_secret
S3_FORCE_PATH_STYLE=true

# Cloudinary
CLOUDINARY_URL=
CLOUDINARY_FOLDER=school-erp

# --- Email (SMTP) ---
MAIL_ENABLED=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME="School ERP"
MAIL_FROM_ADDRESS=no-reply@schoolerp.local

# --- SMS provider ('log' | 'msg91' | 'twilio') ---
SMS_DRIVER=log
SMS_SENDER_ID=SCHOOL
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Firebase Cloud Messaging (push) ---
FCM_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Razorpay ---
PAYMENTS_ENABLED=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Queues (BullMQ) ---
QUEUE_ENABLED=true
QUEUE_CONCURRENCY=5

# --- Logging ---
LOG_LEVEL=debug
LOG_PRETTY=true

# --- Swagger ---
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# --- Seed / bootstrap super admin ---
SUPERADMIN_EMAIL=superadmin@schoolerp.local
SUPERADMIN_PASSWORD=SuperAdmin@123
