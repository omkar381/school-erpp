// ===========================================================================
//  SCHOOL ERP PLATFORM — PRISMA SCHEMA
//  Multi-tenant (shared database, shared schema, discriminated by schoolId)
//  PostgreSQL 16
// ===========================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

