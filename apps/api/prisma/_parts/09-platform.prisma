
// ===========================================================================
//  DOCUMENTS
// ===========================================================================

model DocumentCategory {
  id          String            @id @default(uuid()) @db.Uuid
  schoolId    String?           @db.Uuid
  name        String
  code        String
  ownerType   DocumentOwnerType @default(GENERIC)
  isRequired  Boolean           @default(false)
  hasExpiry   Boolean           @default(false)
  createdAt   DateTime          @default(now())

  documents   Document[]

  @@unique([schoolId, code])
  @@map("document_categories")
}

model Document {
  id           String            @id @default(uuid()) @db.Uuid
  schoolId     String            @db.Uuid
  categoryId   String?           @db.Uuid

  ownerType    DocumentOwnerType
  studentId    String?           @db.Uuid
  staffId      String?           @db.Uuid
  guardianId   String?           @db.Uuid

  title        String
  description  String?
  fileName     String
  storageKey   String            @unique
  mimeType     String
  sizeBytes    Int
  checksum     String?
  /// Public documents are served by CDN; private ones need a signed URL
  isPublic     Boolean           @default(false)
  issueDate    DateTime?         @db.Date
  expiryDate   DateTime?         @db.Date
  isVerified   Boolean           @default(false)
  verifiedById String?           @db.Uuid
  verifiedAt   DateTime?

  uploadedById String?           @db.Uuid
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?

  school       School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  category     DocumentCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  student      Student?          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  staff        Staff?            @relation(fields: [staffId], references: [id], onDelete: Cascade)
  guardian     Guardian?         @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  uploadedBy   User?             @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([schoolId, ownerType])
  @@index([studentId])
  @@index([staffId])
  @@index([expiryDate])
  @@map("documents")
}

// ===========================================================================
//  AUDIT / OPS
// ===========================================================================

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  schoolId   String?     @db.Uuid
  userId     String?     @db.Uuid

  action     AuditAction
  module     String
  entity     String
  entityId   String?
  description String?
  /// Snapshot before the change (sensitive fields redacted)
  oldValue   Json?
  /// Snapshot after the change (sensitive fields redacted)
  newValue   Json?

  ipAddress  String?
  userAgent  String?
  requestId  String?
  /// Set when a super admin acted while impersonating another user
  impersonatedById String? @db.Uuid
  createdAt  DateTime    @default(now())

  school     School?     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

/// Tracks long-running background work so clients can poll progress.
model JobRun {
  id           String    @id @default(uuid()) @db.Uuid
  schoolId     String?   @db.Uuid
  queue        String
  jobName      String
  jobId        String?
  status       JobStatus @default(QUEUED)
  progress     Int       @default(0)
  total        Int?
  processed    Int       @default(0)
  succeeded    Int       @default(0)
  failed       Int       @default(0)
  /// Input parameters (never contains secrets)
  payload      Json      @default("{}")
  result       Json?
  errors       Json      @default("[]")
  resultStorageKey String?
  requestedById String?  @db.Uuid
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  school       School?   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, status, createdAt])
  @@index([jobId])
  @@map("job_runs")
}

// ===========================================================================
//  ADMISSIONS / CERTIFICATES / ID CARDS
// ===========================================================================

model AdmissionEnquiry {
  id             String                 @id @default(uuid()) @db.Uuid
  schoolId       String                 @db.Uuid
  academicYearId String?                @db.Uuid

  enquiryNumber  String
  studentFirstName String
  studentLastName String?
  dateOfBirth    DateTime?              @db.Date
  gender         Gender?
  seekingClass   String
  previousSchool String?

  parentName     String
  relation       GuardianRelation       @default(FATHER)
  phone          String
  email          String?
  addressLine1   String?
  city           String?

  /// WALK_IN | WEBSITE | PHONE | REFERRAL | SOCIAL_MEDIA | ADVERTISEMENT
  source         String                 @default("WALK_IN")
  status         AdmissionEnquiryStatus @default(NEW)
  notes          String?
  followUpDate   DateTime?              @db.Date
  assignedToId   String?                @db.Uuid
  /// Set once the enquiry is converted into a real student record
  convertedStudentId String?            @db.Uuid
  convertedAt    DateTime?
  rejectionReason String?

  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  school         School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear?          @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  attachments    Attachment[]

  @@unique([schoolId, enquiryNumber])
  @@index([schoolId, status, createdAt])
  @@index([phone])
  @@map("admission_enquiries")
}

model CertificateTemplate {
  id          String          @id @default(uuid()) @db.Uuid
  schoolId    String?         @db.Uuid
  type        CertificateType
  name        String
  /// Handlebars-style body with {{placeholders}}
  bodyTemplate String
  headerHtml  String?
  footerHtml  String?
  /// Declared placeholders, used to build the generation form
  variables   String[]        @default([])
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  certificates Certificate[]

  @@unique([schoolId, type, name])
  @@map("certificate_templates")
}

model Certificate {
  id                String          @id @default(uuid()) @db.Uuid
  schoolId          String          @db.Uuid
  templateId        String?         @db.Uuid
  studentId         String?         @db.Uuid
  staffId           String?         @db.Uuid

  type              CertificateType
  certificateNumber String
  /// Values used to render the template, retained for reprints
  data              Json            @default("{}")
  issuedOn          DateTime        @db.Date
  issuedById        String?         @db.Uuid
  pdfStorageKey     String?
  isRevoked         Boolean         @default(false)
  revokedAt         DateTime?
  revokeReason      String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  school            School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  template          CertificateTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  student           Student?             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([schoolId, certificateNumber])
  @@index([schoolId, type])
  @@index([studentId])
  @@map("certificates")
}

model IdCard {
  id            String   @id @default(uuid()) @db.Uuid
  schoolId      String   @db.Uuid
  studentId     String?  @db.Uuid
  staffId       String?  @db.Uuid
  cardNumber    String
  /// Payload encoded into the printed QR code
  qrPayload     String
  issuedOn      DateTime @db.Date
  validTill     DateTime? @db.Date
  pdfStorageKey String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student       Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  staff         Staff?   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([schoolId, cardNumber])
  @@index([studentId])
  @@index([staffId])
  @@map("id_cards")
}

// ===========================================================================
//  SUPPORT
// ===========================================================================

model SupportTicket {
  id           String         @id @default(uuid()) @db.Uuid
  schoolId     String?        @db.Uuid
  requesterId  String         @db.Uuid
  assigneeId   String?        @db.Uuid

  ticketNumber String         @unique
  subject      String
  description  String
  category     String         @default("GENERAL")
  priority     TicketPriority @default(MEDIUM)
  status       TicketStatus   @default(OPEN)
  resolvedAt   DateTime?
  closedAt     DateTime?
  firstResponseAt DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  school       School?         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  requester    User            @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  assignee     User?           @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages     TicketMessage[]
  attachments  Attachment[]

  @@index([schoolId, status])
  @@index([requesterId])
  @@index([assigneeId, status])
  @@map("support_tickets")
}

model TicketMessage {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @db.Uuid
  authorId  String   @db.Uuid
  body      String
  /// Internal notes are hidden from the requester
  isInternal Boolean @default(false)
  createdAt DateTime @default(now())

  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

// ===========================================================================
//  PUBLIC WEBSITE CMS
// ===========================================================================

model WebsitePage {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @db.Uuid
  slug         String
  title        String
  /// Structured blocks rendered by the public site
  content      Json     @default("[]")
  excerpt      String?
  coverImageUrl String?
  metaTitle    String?
  metaDescription String?
  ogImageUrl   String?
  isPublished  Boolean  @default(false)
  sortOrder    Int      @default(0)
  showInMenu   Boolean  @default(true)
  publishedAt  DateTime?
  updatedById  String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, slug])
  @@index([schoolId, isPublished])
  @@map("website_pages")
}

model GalleryAlbum {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @db.Uuid
  title       String
  slug        String
  description String?
  coverImageUrl String?
  eventDate   DateTime? @db.Date
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  photos      GalleryPhoto[]

  @@unique([schoolId, slug])
  @@map("gallery_albums")
}

model GalleryPhoto {
  id         String   @id @default(uuid()) @db.Uuid
  albumId    String   @db.Uuid
  url        String
  storageKey String?
  caption    String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  album      GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([albumId, sortOrder])
  @@map("gallery_photos")
}
